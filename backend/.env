PORT=5000
MONGO_URI=mongodb://localhost:27017/linkvault
# or your MongoDB Atlas string

# Firebase Config (You need to generate a service account in Firebase Console)
# If using a local file, path to it:
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Or you can skip this if you set up the specific bucket in utils/firebase.js
FIREBASE_BUCKET_URL=your-project-id.appspot.com